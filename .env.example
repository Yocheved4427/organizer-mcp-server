# Environment Configuration for Organizer MCP Server
# Copy this file to .env and customize as needed

# -----------------------------------------------------------------------
# SECURITY: Restrict the server to specific directories.
# Comma-separated list of absolute paths the server is allowed to access.
# If left empty, known system directories are blocked as a fallback,
# but setting this explicitly is strongly recommended.
# Example (Windows): ORGANIZER_ALLOWED_PATHS=C:/Users/YourName/Documents,C:/Users/YourName/Downloads
# Example (macOS/Linux): ORGANIZER_ALLOWED_PATHS=/home/yourname/documents,/home/yourname/downloads
ORGANIZER_ALLOWED_PATHS=C:\Users\User\OneDrive\מסמכים,C:\TARGILIM,C:\Users\User\Downloads
# -----------------------------------------------------------------------

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum file size to read (in bytes)
# Default: 50000 (50KB)
MAX_FILE_READ_SIZE=50000

# Minimum file size for duplicate detection (in bytes)
# Default: 1024 (1KB)
MIN_DUPLICATE_SIZE=1024

# Server name for MCP protocol
SERVER_NAME=organizer-mcp-server

# Enable detailed logging to file
LOG_TO_FILE=true

# Log file path (relative to project root)
LOG_FILE_PATH=organizer-mcp-server.log
